{
 "schema_version": 1,
 "natures": [
  {
   "id": "rule",
   "label": "Rule / policy the division creates and manages",
   "description": "Standing rules, norms, specifications, schemes, SOPs, delegations and guidelines issued and maintained by the division."
  },
  {
   "id": "forwarded",
   "label": "Forwarded Government order",
   "description": "Orders and rates decided elsewhere (Ministry, DoPT, Finance, Gazette) that the division circulates or applies. The division does not create the rule."
  },
  {
   "id": "routine",
   "label": "Routine administration or operations",
   "description": "Seniority lists, examinations, appointments, orders, allocations, programmes, meetings and similar day-to-day work."
  },
  {
   "id": "data_request",
   "label": "Data request or return",
   "description": "Information, returns, reports or data called for from field offices."
  },
  {
   "id": "dissemination",
   "label": "Data dissemination or reply",
   "description": "Replies and information given out: RTI replies, Parliament questions, publications."
  },
  {
   "id": "communication",
   "label": "Communication with field offices",
   "description": "Reminders, advisories, notices, observances, announcements and instructions to offices."
  }
 ],
 "method": "Each topic row was labelled by hand from its description (primary nature, plus a secondary where the topic mixes kinds of work). The division mix is an estimate from circular titles using keyword rules (individual cases such as named-officer orders count as routine); it is approximate and Hindi-only titles are classified on Hindi keywords.",
