    {
      "id": "roi-2011-04-27-modifies-interim-rate",
      "source": "roi-2011-04-27",
      "target": "roi-2011-03-18",
      "type": "partially_modifies",
      "verification": "source_checked",
      "effective_from": null,
      "effective_date_evidence": null,
      "evidence": {
        "document_id": "roi-2011-04-27",
        "page_number": 1,
        "quote": "In partial modification to this office letter"
      },
      "scope": "Only the interim rate for settling claims during 2011-12 before a 2011-12 rate is declared (8.5% in the March circular, 9.5% in the April order). The 9.5% declared for 2010-11 is not changed."
    },
    {
      "id": "roi-2012-03-15-implements-2011-12-rate",
