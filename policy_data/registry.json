{
  "schema_version": 1,
  "policies": [
    {
      "id": "delegation",
      "label": "Delegation of powers",
      "scope": "Matter-specific EPFO administrative, financial and sanctioning powers; authority layers and historical changes",
      "path": "delegation/policy.json",
      "include": "delegat.*power|power.*delegat|sanctioning authorit|competent authorit.*(?:financial|expenditure|sanction)",
      "exclude": "power of attorney",
      "route": "delegation_policy"
    },
    {
      "id": "employee_benefits",
      "label": "EPFO employee benefits",
      "scope": "EPFO staff benefits: briefcase, devices, communications, newspapers and medical reimbursement; not EPF member entitlements",
      "path": "employee_benefits/policy.json",
      "include": "briefcase|hand.?bag|office bag|ladies purse|laptop|notebook|newspaper|news paper|telephone.*(?:reimburs|benefit)|(?:reimburs|benefit).*telephone|mobile.*(?:reimburs|bill)|(?:reimburs|bill).*mobile|medical.*(?:reimburs|allowance)|(?:reimburs|fixed).*medical|staff.*benefit|EPFO.*employee.*benefit|\\bCGHS\\b|CS\\s*\\(MA\\)",
      "exclude": "EPF member|EPS pension|insured person|Aadhaar|UAN",
      "route": "employee_benefits_policy"
    },
    {
      "id": "bank_kyc",
      "label": "Bank KYC / cheque upload",
      "scope": "EPFO UAN bank seeding and cheque/passbook upload requirements",
      "path": "bank_kyc/policy.json",
      "include": "bank\\s*kyc|cheque\\s*(?:leaf|upload)|passbook.*upload|upload.*(?:passbook|cheque)|(?:bank\\s*account|bank\\s*details).*(?:seed|link|approv|validat)|(?:seed|link|approv|validat).*bank\\s*(?:account|details)",
      "exclude": "\\bcpps\\b|pension.*(?:bank|payment)|UIDAI|NPCI.*(?:mapping|mapper)|ELI|PMVBRY",
      "route": "bank_kyc_policy"
    },
    {
      "id": "mid_delinking",
      "label": "MID de-linking",
      "scope": "Wrong MID linked to UAN; January 2025 process and April 2026 contribution extension",
      "path": "mid_delinking/policy.json",
      "include": "de[ -]?link|delink|wrong.*(?:member\\s*id|\\bmid\\b)|erroneous.*(?:member\\s*id|\\bmid\\b)",
      "exclude": "aadhaar|aadhar",
      "route": "mid_delinking_policy"
    },
    {
      "id": "eps_corrections",
      "label": "EPS contribution corrections",
      "scope": "Erroneous EPS membership and contribution correction; concurrent membership context",
      "path": "eps_corrections/policy.json",
      "include": "(?:erroneous|wrong|incorrect|rectif|correct).*(?:EPS|pension\\s*contribut)|(?:EPS|pension\\s*contribut).*(?:erroneous|wrong|incorrect|rectif|correct)|concurrent.*(?:EPS|pension)|multiple\\s+account.*EPS",
      "exclude": "higher\\s*pension|PoHW",
      "route": "eps_corrections_policy"
    },
    {
      "id": "higher_pension",
      "label": "Higher pension / PoHW",
      "scope": "EPS pension on higher wages and related joint options; excludes JD profile correction and general EPF enrolment",
      "path": "higher_pension/policy.json",
      "include": "higher[ -]?(?:pension|wage)|pension\\s+on\\s+higher|\\bpohw\\b|joint\\s+option|उच्च\\s*पेंशन",
      "exclude": "",
      "route": "higher_pension_policy"
    },
    {
      "id": "cpps",
      "label": "Pension payment / CPPS",
      "scope": "EPS pension payment routing, PPO office, interim scroll schedules and DLC; excludes pension entitlement and staff pensions",
      "path": "pension_payment/policy.json",
      "include": "\\bcpps\\b|centrali[sz]ed\\s+pension|pension.*(?:payment|disburs|bank|scroll)|\\bppo\\b.*(?:transfer|revis)|digital life certificate|\\bdlc\\b",
      "exclude": "staff pension|CCS|CPPC",
      "route": "cpps_policy"
    },
    {
      "id": "transfers",
      "label": "Transfer claims",
      "scope": "EPF account transfer claims, Form 13, Annexure K, overlapping service; excludes employee postings and EDLI death benefits",
      "path": "transfer_claims/policy.json",
      "include": "transfer\\s+(?:claim|of\\s+(?:EPF|PF|account)|(?:EPF|PF)\\s+account)|(?:PF|EPF|EPS|service|account).*transfer|form\\s*13|annexure\\s*[ -]?k|overlap.*service",
      "exclude": "cadre|posting|staff transfer|compassionate|\\bEDLI\\b|death benefit",
      "route": "transfers_policy"
    },
    {
      "id": "advances",
      "label": "Advances / auto-settlement",
      "scope": "Member EPF advances, auto-processing and withdrawal-reform announcements; excludes staff advances, bonus and settlement of employer dues",
      "path": "advances/policy.json",
      "include": "auto[ -]?(?:settle|mode|claim)|(?:EPF|PF|illness|housing|marriage|education|covid).*advance|para(?:graph)?\\s*68|partial\\s+withdraw|withdrawal.*(?:rule|reform)",
      "exclude": "bonus|\\bPLB\\b|staff advance|LTC|productivity|penal damage",
      "route": "advances_policy"
    },
    {
      "id": "aadhaar",
      "label": "Member profile / Aadhaar",
      "scope": "EPFO member-profile correction, Aadhaar seeding and correcting Aadhaar linked to UAN; not changing the Aadhaar database itself or ECR deadlines",
      "path": "member_profile_aadhaar/policy.json",
      "include": "(?:aadhaar|aadhar|आधार).*(?:seed|correct|mismatch|profile|uan|dob|birth|जोड़|सुधार)|(?:seed|correct|mismatch|profile|uan|dob|birth).*(?:aadhaar|aadhar)|member\\s+profile\\s+correction",
      "exclude": "higher[ -]?pension|joint option|26\\s*\\(6\\)|ईसीआर|\\becr\\b|UIDAI.*(?:address|mobile).*update|update.*(?:address|mobile).*UIDAI|(?:aadhaar|aadhar).*(?:address|mobile).*(?:update|correct|change)|(?:update|correct|change).*(?:aadhaar|aadhar).*(?:address|mobile)",
      "route": "aadhaar_policy"
    },
    {
      "id": "jd",
      "label": "JD member profile",
      "scope": "WSU Joint Declaration member-profile correction only",
      "path": "joint_declaration/policy.json",
      "include": "joint\\s*declaration|\\bjd\\b|member\\s+profile|संयुक्त घोषणा|जॉइंट डिक्लेरेशन",
      "exclude": "higher[ -]?pension|joint option|26\\s*\\(6\\)|उच्च पेंशन|(?:aadhaar|aadhar).*(?:address|mobile).*(?:update|correct|change)|(?:update|correct|change).*(?:aadhaar|aadhar).*(?:address|mobile)",
      "route": "jd_policy"
    }
  ]
}
